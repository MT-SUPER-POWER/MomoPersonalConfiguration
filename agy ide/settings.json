  "editor.colorDecorators": true,
  "colorize.decoration_type": "dot",
  "colorize.languages": [
    "dart",
    "*"
  ],
  "workbench.iconTheme": "material-icon-theme",
  "editor.tabSize": 2,
  "vscode-neovim.neovimExecutablePaths.win32": "D:\\Apps\\Dev\\nvim\\bin\\nvim.exe",
  "vscode-neovim.neovimInitVimPaths.win32": "D:\\Github\\MomoPersonalConfiguration\\nvim\\init.lua",
