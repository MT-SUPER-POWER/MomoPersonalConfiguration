  "go.toolsManagement.autoUpdate": true,
  "debug.inlineValues": false,
  "mermaidViewer.previewAppearance": "matchVSCode",
  "mermaidViewer.useVSCodeTheme": false,
  "mermaidViewer.theme": "dark",
  "security.promptForLocalFileProtocolHandling": false,
  "explorer.autoReveal": true,
  "editor.semanticTokenColorCustomizations": {
    "rules": {
      "interface": {
        "foreground": "#b8ce82",
      },
      "namespace": "#cccccc",
      "enum": "#b8ce82",
      "struct": {
        "foreground": "#86C691",
      },
      "inactive": {
        "foreground": "#6A6A6A",
      },
    },
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "entity.name.type.interface.cs",
        "settings": {
          "foreground": "#b8ce82",
        },
      },
      {
        "scope": "entity.name.type.enum.cs",
        "settings": {
          "foreground": "#b8ce82",
        },
      },
      {
        "scope": "entity.name.type.struct.cs",
        "settings": {
          "foreground": "#86C691",
        },
      },
      {
        "scope": "variable.other.enummember.cs",
        "settings": {
          "foreground": "#4FC1FF",
        },
      },
    ],
  },
  "workbench.colorTheme": "SynthWave84",
  // =================== Default Formatter ===================
  "[mdx]": {
    "editor.defaultFormatter": "unifiedjs.vscode-mdx",
  },
  "workbench.editorAssociations": {
    "*.html": "default",
  },
  "[dockercompose]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-containers",
  },
  "editor.minimap.enabled": false,
  "gitlens.graph.details.location": "auto",
  "diffEditor.hideUnchangedRegions.enabled": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": true,
  // 自动换行，超过视觉宽度的内容自动换行，方便阅览
  "editor.wordWrap": "on", // 编辑器
  "diffEditor.wordWrap": "on",
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  }
