{
  // ==========================================================
  //            通用与文件行为
  // ==========================================================
  "chat.viewSessions.orientation": "stacked",
  // git 自动拉取
  "git.autofetch": true,
  // debug inline values
  "debug.inlineValues": "off",
  // 安全提示
  "security.promptForLocalFileProtocolHandling": false,
  // 文件面包屑
  "breadcrumbs.enabled": true,
  // notebook 行号
  "notebook.lineNumbers": "on",
  // 视口缩放
  "window.zoomLevel": 0.3,
  // 文件换行
  "files.trimTrailingWhitespace": true,
  // 文件插入末尾
  "files.insertFinalNewline": true,
  // debug console 字体大小
  "debug.console.fontSize": 15,
  // 文件管理器自动 reveal
  "explorer.autoReveal": true,
  // 文件管理器折叠文件夹
  "explorer.compactFolders": false,
  // 不会出现只有一个文件夹还强制折叠为一条的情况
  "markdown.preview.fontSize": 16,
  // ==========================================================
  //            集成终端
  // ==========================================================
  // 终端箭头连体字符
  "terminal.integrated.fontLigatures.enabled": true,
  // 终端字体大小
  "terminal.integrated.fontSize": 15,
  // 终端字体行高
  "terminal.integrated.lineHeight": 1.2,
  // 终端吸顶效果
  "terminal.integrated.stickyScroll.enabled": false,
  // 终端默认Shell
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  // 终端字体
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrainsMono NF', 'JetBrains Mono', monospace",
  // ==========================================================
  //            编辑器显示与输入
  // ==========================================================
  // 隐藏 minimap
  "editor.minimap.enabled": false,
  // 编辑器光标平滑移动
  "editor.cursorSmoothCaretAnimation": "explicit",
  // 编辑器平滑滚动
  "editor.smoothScrolling": true,
  // 编辑器字体大小
  "editor.fontSize": 17,
  // 编辑器字体行高
  "editor.lineHeight": 2,
  // 编辑器行号
  "editor.lineNumbers": "relative",
  // 编辑器字体
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrainsMono NF', 'JetBrains Mono', monospace",
  // 色块之类的颜色提示
  "editor.colorDecorators": true,
  // 自动换行，超过视觉宽度的内容自动换行，方便阅览
  "editor.wordWrap": "on",
  // 编辑器光标闪烁
  "editor.cursorBlinking": "blink",
  // 编辑器灯泡
  "editor.lightbulb.enabled": "off",
  // 编辑器滚动条
  "editor.scrollbar.horizontal": "hidden",
  // 编辑器吸顶效果
  "editor.stickyScroll.enabled": false,
  // 编辑器粘贴时格式化
  "editor.formatOnPaste": true,
  // 编辑器滚动条
  "editor.scrollbar.vertical": "hidden",
  // 快速补全的时候，显示的 tab 前面带 icon
  "editor.suggest.showIcons": true,
  // 快速补全文本类型也可以有补全，这样子 tailwind 才会生效
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "on",
  },
  // ==========================================================
  //            差异比较视图
  // ==========================================================
  // diffEditor自动换行，超过视觉宽度的内容自动换行，方便阅览
  "diffEditor.wordWrap": "on",
  // 隐藏未更改的区域
  "diffEditor.hideUnchangedRegions.enabled": true,
  // 忽略空白字符
  "diffEditor.ignoreTrimWhitespace": false,
  // 以并排视图显示 diff
  "diffEditor.renderSideBySide": true,
  // ==========================================================
  //            工作台布局与主题
  // ==========================================================
  "workbench.auxiliaryActivityBar.location": "default",
  "workbench.activityBar.location": "top",
  "workbench.editor.showTabs": "multiple",
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": true,
  "workbench.iconTheme": "material-icon-theme",
  "workbench.colorTheme": "SynthWave84",
  "workbench.tree.enableStickyScroll": true,
  "workbench.tree.indent": 10,
  // ==========================================================
  //            跨配置档案共享设置
  // ==========================================================
  "workbench.settings.applyToAllProfiles": [
    "http.proxy",
    "http.proxyStrictSSL",
    "window.zoomLevel",
    "update.mode",
    "extensions.ignoreRecommendations",
    "editor.fontSize",
    "editor.fontFamily",
    "editor.lineHeight",
    "editor.lineNumbers",
    "editor.cursorSmoothCaretAnimation",
    "editor.cursorBlinking",
    "editor.smoothScrolling",
    "editor.minimap.enabled",
    "editor.stickyScroll.enabled",
    "editor.formatOnPaste",
    "editor.scrollbar.vertical",
    "editor.scrollbar.horizontal",
    "editor.lightbulb.enabled",
    "editor.suggest.showIcons",
    "editor.quickSuggestions",
    "workbench.editor.showTabs",
    "workbench.startupEditor",
    "workbench.activityBar.location",
    "workbench.tree.indent",
    "workbench.tree.enableStickyScroll",
    "workbench.tips.enabled",
    "breadcrumbs.enabled",
    "explorer.compactFolders",
    "terminal.integrated.fontSize",
    "terminal.integrated.fontFamily",
    "terminal.integrated.lineHeight",
    "terminal.integrated.fontLigatures.enabled",
    "terminal.integrated.stickyScroll.enabled",
    "terminal.integrated.defaultProfile.windows",
    "files.trimTrailingWhitespace",
    "files.insertFinalNewline",
    "extensions.experimental.affinity",
    "vscode-neovim.useWSL",
    "vscode-neovim.wslDistribution",
    "vscode-neovim.ctrlKeysForNormalMode",
    "github.copilot.nextEditSuggestions.enabled",
    "github.copilot.enable",
    "chat.mcp.gallery.enabled",
    "chat.mcp.autostart",
    "custom-ui-style.font.sansSerif",
    "custom-ui-style.stylesheet",
    "todo-tree.tree.flat",
    "todo-tree.highlights.enabled",
    "todo-tree.filtering.excludeGlobs",
    "todo-tree.general.tags",
    "todohighlight.exclude",
    "todohighlight.keywords",
    "better-comments.tags",
    "debug.console.fontSize",
    "markdown.preview.fontSize",
    "editor.tabSize",
    "workbench.iconTheme",
    "editor.colorDecorators",
    "colorize.decoration_type",
    "colorize.languages",
    "gitblame.inlineMessageEnabled",
  ],
  // ==========================================================
  //            启动时的辅助侧栏
  // ==========================================================
  // 防止侧边栏每一次重启都打开
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  // ==========================================================
  //            Neovim 扩展与按键接管
  // ==========================================================
  "extensions.ignoreRecommendations": true,
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
  "vscode-neovim.wslDistribution": "Ubuntu-24.04",
  "vscode-neovim.ctrlKeysForNormalMode": [
    "b",
    "d",
    "e",
    "f",
    "h",
    "i",
    "j",
    "k",
    "l",
    "m",
    "o",
    "r",
    "t",
    "u",
    "y",
    "/",
    "]",
    "backspace",
    "delete",
    "g",
    "up",
    "down",
    "left",
    "right",
  ],
  "vscode-neovim.ctrlKeysForInsertMode": [
    "a",
    "d",
    "h",
    "j",
    "m",
    "o",
    "r",
    "t",
    "u",
    "w",
  ],
  "vscode-neovim.neovimExecutablePaths.win32": "D:\\Apps\\Dev\\nvim\\bin\\nvim.exe",
  "vscode-neovim.neovimInitVimPaths.win32": "D:\\Github\\MomoPersonalConfiguration\\nvim\\init.lua",
  // ==========================================================
  //            自定义界面样式
  // ==========================================================
  "custom-ui-style.stylesheet": {
    ".notification-toast": "box-shadow: none !important",
    ".quick-input-widget.show-file-icons": "box-shadow: none !important",
    ".quick-input-widget": "top: 25vh !important",
    ".quick-input-list .scrollbar": "display: none",
    ".monaco-action-bar.quick-input-inline-action-bar": "display: none",
    ".editor-widget.find-widget": "box-shadow: none; border-radius: 4px",
    ".quick-input-titlebar": "background: #100B15 !important",
    ".monaco-workbench .part.editor > .content .editor-group-container > .title.title-border-bottom:after": "display: none",
    ".monaco-scrollable-element > .shadow.top": "display: none",
    ".sidebar .title-label": "padding: 0 !important",
    ".sidebar": "border: none !important",
    ".monaco-workbench .monaco-list:not(.element-focused):focus:before": "outline: none !important",
    ".monaco-list-row.focused": "outline: none !important",
    ".monaco-editor .scroll-decoration": "display: none",
    ".title.show-file-icons .label-container .monaco-icon-label.file-icon": "justify-content: center; padding: 0 !important",
    ".title .monaco-icon-label:after": "margin-right: 0",
    ".monaco-workbench .part.editor > .content .editor-group-container > .title > .label-container > .title-label": "padding-left: 60px",
    ".title .monaco-icon-label.file-icon": "margin: 0 60px",
    ".monaco-editor .cursors-layer .cursor": "background-image: linear-gradient(135deg, #ffaffc 10%, #DA70D6 100%)",
    ".monaco-workbench .pane-composite-part>.title>.composite-bar-container, .monaco-workbench .pane-composite-part>.header-or-footer>.composite-bar-container": "display: flex; justify-content: center;",
  },
  // ==========================================================
  //            TODO 标记与高亮
  // ==========================================================
  "todo-tree.tree.flat": true,
  "todo-tree.highlights.enabled": false,
  "todo-tree.filtering.excludeGlobs": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/bower_components/**",
    "**/build/**",
    "**/.vscode/**",
    "**/.github/**",
    "**/_output/**",
    "**/*.min.*",
    "**/*.map",
    "**/*.md",
    "**/*.MD",
  ],
  "todo-tree.general.tags": [
    "TODO",
    "FIXME",
    "DEBUG",
    "WARNING",
    "BUG",
    "NOTE",
    "OPTIMIZE",
    "REVIEW",
    "DEPRECATED",
  ],
  "todohighlight.exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/coverage/**",
    "**/.vscode/**",
  ],
  "todohighlight.keywords": [
    {
      "text": "TODO:",
      "color": "#ff37a6",
      "backgroundColor": "#2d0036",
      "border": "1px solid #ff37a6",
      "borderRadius": "2px",
    },
    {
      "text": "FIXME:",
      "color": "#00fff7",
      "backgroundColor": "#1a0036",
      "border": "1px solid #00fff7",
      "borderRadius": "2px",
    },
    {
      "text": "DEBUG:",
      "color": "#ffe600",
      "backgroundColor": "#2d0036",
      "border": "1px solid #ffe600",
      "borderRadius": "2px",
    },
    {
      "text": "WARNING:",
      "color": "#c16b4f",
      "backgroundColor": "none",
      "border": "1px solid #ffe600",
      "borderRadius": "2px",
    },
    {
      "text": "BUG:",
      "color": "#ff005e",
      "backgroundColor": "#2d0036",
      "border": "1px solid #ff005e",
      "borderRadius": "2px",
    },
    {
      "text": "NOTE:",
      "color": "#00fff7",
      "backgroundColor": "#2d0036",
      "border": "1px solid #00fff7",
      "borderRadius": "2px",
    },
    {
      "text": "OPTIMIZE:",
      "color": "#ff37a6",
      "backgroundColor": "#1a0036",
      "border": "1px solid #ff37a6",
      "borderRadius": "2px",
    },
    {
      "text": "REVIEW:",
      "color": "#3cff00",
      "backgroundColor": "#1a0036",
      "border": "1px solid #ffe600",
      "borderRadius": "2px",
    },
    {
      "text": "DEPRECATED:",
      "color": "#b45309", // 偏暗的橘色，保证文字可读性
      "backgroundColor": "#1a0036", // 极淡的琥珀色背景
      "border": "1px solid #fcd34d", // 柔和的橘色边框
      "borderRadius": "4px",
    },
  ],
  // ==========================================================
  //            颜色预览
  // ==========================================================
  // colorize 插件配置
  "colorize.decoration_type": "dot",
  "colorize.languages": [
    "dart",
  ],
  // ==========================================================
  //            Mermaid 图表预览
  // ==========================================================
  "mermaidViewer.previewAppearance": "matchVSCode",
  "mermaidViewer.useVSCodeTheme": false,
  "mermaidViewer.theme": "dark",
  // ==========================================================
  //            C# 开发工具
  // ==========================================================
  // C# dev 默认主页
  "csharp-dev-tools.homepage.enabled": false,
  // ==========================================================
  //            语言工具与格式化
  // ==========================================================
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[mdx]": {
    "editor.defaultFormatter": "unifiedjs.vscode-mdx",
  },
  "[dockercompose]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-containers",
  },
  "go.toolsManagement.autoUpdate": true,
}
