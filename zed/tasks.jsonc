// Zed tasks
// Git Graph 右键菜单：带 "git-command" 标签的任务会出现在提交 / 分支标签的右键菜单中。
// 将本文件作为 tasks.json，与 git-graph.cjs 一起放到 Zed 用户配置目录。
// 任务默认在选中的仓库根目录运行，交互输入在 Zed 内置终端中完成。
// Git Graph 任务会把命令拼成 shell 命令行。把 -e 的脚本作为带引号的 command 内容。
[
  // ==========================================================
  //            建立分支、检出与摘取
  // ==========================================================
  {
    "label": "Create Branch...",
    "command": "node -e \"const { env, platform, argv } = process; const home = require('node:os').homedir(); const dir = env.ZED_GIT_GRAPH_DIR || (platform === 'win32' ? env.APPDATA + '/Zed' : ((platform !== 'darwin' && (env.FLATPAK_XDG_CONFIG_HOME || env.XDG_CONFIG_HOME)) || home + '/.config') + '/zed'); require(require('node:path').join(dir, 'git-graph.cjs'))(...argv.slice(1));\" branch $ZED_GIT_SHA",
    "show_command": false,
    "tags": ["git-command"],
  },
  {
    "label": "Checkout",
    "command": "node -e \"const { env, platform, argv } = process; const home = require('node:os').homedir(); const dir = env.ZED_GIT_GRAPH_DIR || (platform === 'win32' ? env.APPDATA + '/Zed' : ((platform !== 'darwin' && (env.FLATPAK_XDG_CONFIG_HOME || env.XDG_CONFIG_HOME)) || home + '/.config') + '/zed'); require(require('node:path').join(dir, 'git-graph.cjs'))(...argv.slice(1));\" checkout $ZED_GIT_SHA",
    "show_command": false,
    "tags": ["git-command"],
  },
  {
    "label": "Cherry Pick",
    "command": "node -e \"const { env, platform, argv } = process; const home = require('node:os').homedir(); const dir = env.ZED_GIT_GRAPH_DIR || (platform === 'win32' ? env.APPDATA + '/Zed' : ((platform !== 'darwin' && (env.FLATPAK_XDG_CONFIG_HOME || env.XDG_CONFIG_HOME)) || home + '/.config') + '/zed'); require(require('node:path').join(dir, 'git-graph.cjs'))(...argv.slice(1));\" cherry-pick $ZED_GIT_SHA",
    "show_command": false,
    "tags": ["git-command"],
  },
  {
    "label": "Revert",
    "command": "node -e \"const { env, platform, argv } = process; const home = require('node:os').homedir(); const dir = env.ZED_GIT_GRAPH_DIR || (platform === 'win32' ? env.APPDATA + '/Zed' : ((platform !== 'darwin' && (env.FLATPAK_XDG_CONFIG_HOME || env.XDG_CONFIG_HOME)) || home + '/.config') + '/zed'); require(require('node:path').join(dir, 'git-graph.cjs'))(...argv.slice(1));\" revert $ZED_GIT_SHA",
    "show_command": false,
    "tags": ["git-command"],
  },

  // ==========================================================
  //            改写历史（谨慎）
  // ==========================================================
  {
    "label": "Drop Commit...",
    "command": "node -e \"const { env, platform, argv } = process; const home = require('node:os').homedir(); const dir = env.ZED_GIT_GRAPH_DIR || (platform === 'win32' ? env.APPDATA + '/Zed' : ((platform !== 'darwin' && (env.FLATPAK_XDG_CONFIG_HOME || env.XDG_CONFIG_HOME)) || home + '/.config') + '/zed'); require(require('node:path').join(dir, 'git-graph.cjs'))(...argv.slice(1));\" drop $ZED_GIT_SHA",
    "show_command": false,
    "tags": ["git-command"],
  },

  // ==========================================================
  //            合并与变基
  // ==========================================================
  {
    "label": "Merge into Current Branch",
    "command": "git",
    "args": ["merge", "$ZED_GIT_SHA"],
    "tags": ["git-command"],
  },
  {
    "label": "Rebase Current Branch Here",
    "command": "git",
    "args": ["rebase", "$ZED_GIT_SHA"],
    "tags": ["git-command"],
  },

  // ==========================================================
  //            重置当前分支
  // ==========================================================
  {
    "label": "Reset Current Branch Here...",
    "command": "node -e \"const { env, platform, argv } = process; const home = require('node:os').homedir(); const dir = env.ZED_GIT_GRAPH_DIR || (platform === 'win32' ? env.APPDATA + '/Zed' : ((platform !== 'darwin' && (env.FLATPAK_XDG_CONFIG_HOME || env.XDG_CONFIG_HOME)) || home + '/.config') + '/zed'); require(require('node:path').join(dir, 'git-graph.cjs'))(...argv.slice(1));\" reset $ZED_GIT_SHA",
    "show_command": false,
    "tags": ["git-command"],
  },

  // ==========================================================
  //            复制到剪贴板
  // ==========================================================
  {
    "label": "Copy Commit Subject",
    "command": "node -e \"const { env, platform, argv } = process; const home = require('node:os').homedir(); const dir = env.ZED_GIT_GRAPH_DIR || (platform === 'win32' ? env.APPDATA + '/Zed' : ((platform !== 'darwin' && (env.FLATPAK_XDG_CONFIG_HOME || env.XDG_CONFIG_HOME)) || home + '/.config') + '/zed'); require(require('node:path').join(dir, 'git-graph.cjs'))(...argv.slice(1));\" copy-subject $ZED_GIT_SHA",
    "show_command": false,
    "hide": "on_success",
    "tags": ["git-command"],
  },
]
