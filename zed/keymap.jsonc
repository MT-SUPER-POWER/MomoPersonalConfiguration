// Zed keymap
// 对应 MomoPersonalConfiguration 核心键位习惯统一映射
[
  // ==========================================================
  //            全局工作区与面板
  // ==========================================================
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-w": "pane::CloseActiveItem",
      // 切换左侧文件树 (与 VS Code Ctrl+B 一致)
      "ctrl-b": "workspace::ToggleLeftDock",
      // 打开大纲面板并切换焦点。
      "ctrl-shift-b": "outline_panel::ToggleFocus",
      // 切换右侧辅助栏 (与 VS Code Ctrl+Alt+B 一致)
      "ctrl-alt-b": "workspace::ToggleRightDock",
      // 切换底部终端面板 (与 VS Code Shift+Alt+J 一致)
      "shift-alt-j": "workspace::ToggleBottomDock",
      // 查看问题/诊断面板 (与 VS Code Shift+Alt+M 一致)
      "shift-alt-m": "diagnostics::Deploy",
      // 唤起 AI 对话面板 (与 VS Code Ctrl+Shift+I 一致)
      "ctrl-shift-i": "agent::ToggleFocus",
      // 终端/面板与代码区一键轮转焦点 (对应 VS Code Ctrl+Esc)
      "ctrl-escape": "workspace::ActivateNextPane",
      // 唤起悬停提示与快速文档 (与 VS Code Ctrl+Q 一致)
      "ctrl-q": "editor::Hover",
      // 快速打开文件，避免误触新建窗口
      "ctrl-shift-n": "file_finder::Toggle"
    }
  },

  // ==========================================================
  //            终端焦点导航
  // ==========================================================
  {
    "context": "Terminal",
    "bindings": {
      // 从终端一键跳回代码编辑器焦点
      "ctrl-escape": "workspace::ActivateNextPane",
      // 允许在终端内直接使用跨分屏方向键切回编辑区
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp"
    }
  },

  // ==========================================================
  //            系统编辑与剪贴板
  // ==========================================================
  {
    "context": "Editor && !menu",
    "bindings": {
      "ctrl-c": "editor::Copy",
      "ctrl-v": "editor::Paste",
      "ctrl-x": "editor::Cut",
      // 编辑器内显式覆盖，确保 Vim 模式也能打开大纲。
      "ctrl-shift-b": "outline_panel::ToggleFocus",
      // 对齐 Shift+F6：重命名光标处的符号及其引用
      "shift-f6": "editor::Rename"
    }
  },

  // ==========================================================
  //            Normal 模式快捷键
  // ==========================================================
  //    增加 !menu 约束：当处于补全/提示下拉列表时，不抢占按键，保障 IDE 补全顺畅
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      // ==========================================================
      //            核心界面快捷键覆盖 (强行压制 Vim 的 PageUp / 光标下移等冲突)
      // ==========================================================
      // 压制 Vim 的 ctrl-b (PageUp)，强制走切换左侧边栏
      "ctrl-b": "workspace::ToggleLeftDock",
      "ctrl-alt-b": "workspace::ToggleRightDock",
      "shift-alt-j": "workspace::ToggleBottomDock",
      "shift-alt-m": "diagnostics::Deploy",
      "ctrl-shift-i": "agent::ToggleFocus",
      "ctrl-shift-w": "pane::CloseActiveItem",
      "ctrl-shift-n": "file_finder::Toggle",
      // 合并当前行与下一行；!menu 由当前上下文保证，不抢补全菜单
      "ctrl-shift-j": "editor::JoinLines",

      // ==========================================================
      //            跨分屏切换焦点 (压制 Vim 的 ctrl-j 下移光标等)
      // ==========================================================
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",

      // ==========================================================
      //            检索与搜索
      // ==========================================================
      // 原生 / 保留给 Vim 原生精准搜索（支持 n / N 逐项跳转）
      // space fw 调出原生 GUI 搜索条
      "space f w": "buffer_search::Deploy",
      // 快速找文件 (Quick Open)
      "space f a": "file_finder::Toggle",
      // 全局搜索文本 (Live Grep)
      "space f g": "pane::DeploySearch",
      // 查看已打开的标签页列表 (Buffers)
      "space f b": "tab_switcher::Toggle",

      // ==========================================================
      //            文件与格式化
      // ==========================================================
      "space f s": "workspace::Save",
      "space f f": "editor::Format",

      // ==========================================================
      //            标签页轮转与关闭
      // ==========================================================
      "shift-j": "pane::ActivatePreviousItem",
      "shift-k": "pane::ActivateNextItem",
      "space c c": "pane::CloseActiveItem",
      "space c a": "pane::CloseAllItems",

      // ==========================================================
      //            LSP 悬停与文档查看
      // ==========================================================
      // ctrl-q 与 gh 直达悬停文档，方便随时查看类型与函数说明
      "ctrl-q": "editor::Hover",
      "g h": "editor::Hover",
      // Vim 滚动动作优先滚动悬浮文档；未显示文档时正常滚动代码。
      // Zed 无独立 hover 焦点上下文，保留 j/k/d/u 的普通编辑含义。
      "ctrl-e": "vim::LineDown",
      "ctrl-y": "vim::LineUp",
      "ctrl-d": "vim::ScrollDown",
      "ctrl-u": "vim::ScrollUp",

      // ==========================================================
      //            分屏尺寸调整 (对齐 <leader>r 与 <leader>w)
      // ==========================================================
      // 【单步精细微调】
      "space r h": "vim::ResizePaneLeft",
      "space r l": "vim::ResizePaneRight",
      "space r j": "vim::ResizePaneDown",
      "space r k": "vim::ResizePaneUp",
      // 【大步快速微调 (连续执行 5 档微调)】
      "space r shift-h": ["action::Sequence", ["vim::ResizePaneLeft", "vim::ResizePaneLeft", "vim::ResizePaneLeft", "vim::ResizePaneLeft", "vim::ResizePaneLeft"]],
      "space r shift-l": ["action::Sequence", ["vim::ResizePaneRight", "vim::ResizePaneRight", "vim::ResizePaneRight", "vim::ResizePaneRight", "vim::ResizePaneRight"]],
      "space r shift-j": ["action::Sequence", ["vim::ResizePaneDown", "vim::ResizePaneDown", "vim::ResizePaneDown", "vim::ResizePaneDown", "vim::ResizePaneDown"]],
      "space r shift-k": ["action::Sequence", ["vim::ResizePaneUp", "vim::ResizePaneUp", "vim::ResizePaneUp", "vim::ResizePaneUp", "vim::ResizePaneUp"]],
      // 【一键平分 / 最大化】
      "space r =": "workspace::ResetPaneSizes",
      "space r m": "workspace::ToggleZoom",
      "space w =": "workspace::ResetPaneSizes",
      "space w m": "workspace::ToggleZoom",
      // 【免前缀调整侧栏】编辑器获得焦点时调整当前打开的 Dock。
      // 中央编辑器分屏仍使用 space r h/l 微调。
      "ctrl-alt-h": ["workspace::IncreaseOpenDocksSize", { "px": 0 }],
      "ctrl-alt-l": ["workspace::DecreaseOpenDocksSize", { "px": 0 }],
      "ctrl-alt-j": "vim::ResizePaneDown",
      "ctrl-alt-k": "vim::ResizePaneUp",

      // ==========================================================
      //            分屏与文件调度 (小写单文件，大写整组)
      // ==========================================================
      // 【单文件】跨分屏投掷
      "space w h": ["workspace::MoveItemToPaneInDirection", { "direction": "left" }],
      "space w l": ["workspace::MoveItemToPaneInDirection", { "direction": "right" }],
      "space w j": ["workspace::MoveItemToPaneInDirection", { "direction": "down" }],
      "space w k": ["workspace::MoveItemToPaneInDirection", { "direction": "up" }],

      // 【整组分屏】极速对调与移动
      "space w x": "workspace::SwapPaneAdjacent",
      "space w shift-h": "workspace::SwapPaneLeft",
      "space w shift-l": "workspace::SwapPaneRight",
      "space w shift-j": "workspace::SwapPaneDown",
      "space w shift-k": "workspace::SwapPaneUp"
    }
  },

  // ==========================================================
  //            Visual 模式快捷键
  // ==========================================================
  {
    "context": "Editor && vim_mode == visual && !VimWaiting && !menu",
    "bindings": {
      "ctrl-shift-w": "pane::CloseActiveItem",
      "ctrl-shift-n": "file_finder::Toggle",
      "ctrl-shift-j": "editor::JoinLines",
      "ctrl-b": "workspace::ToggleLeftDock",
      "space f f": "editor::Format",
      "shift-j": "pane::ActivatePreviousItem",
      "shift-k": "pane::ActivateNextItem"
    }
  },
  // ==========================================================
  //            多光标选择与单词跳转
  // ==========================================================
  // 多光标选择：保留原有 wl/wL 分屏操作，n/N 表示下一个/上一个。
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu",
    "bindings": {
      "space w n": "vim::SelectNext",
      "space w shift-n": "vim::SelectPrevious",
      "space w >": ["editor::SelectNext", { "replace_newest": true }],
      "space w <": ["editor::SelectPrevious", { "replace_newest": true }],
      "space w a": "editor::SelectAllMatches",
      // 对齐 agyIDE 的 Hop 单词跳转：空格、空格、w，再输入目标标签。
      "space space w": "vim::HelixJumpToWord"
    }
  },
  // ==========================================================
  //            扩充文本对象
  // ==========================================================
  // mini.ai 常用扩充对象：参数、任意引号、任意括号，使用 Zed 原生动作。
  // 仅在等待文本对象时生效；Normal 模式中的 a、b、q 保持原意。
  {
    "context": "vim_operator == a || vim_operator == i || vim_operator == cs",
    "bindings": {
      // dia / cia / daa：参数；范围由当前语言的语法解析决定。
      "a": "vim::Argument",
      // diq / ciq / daq：引号；dib / cib / dab：括号。
      "q": "vim::MiniQuotes",
      "b": "vim::MiniBrackets"
    }
  },
  // ==========================================================
  //            文件树操作与 Dock 尺寸
  // ==========================================================
  // 文件树快捷键；输入文件名时不接管字母键。
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      // 文件树是 Dock；显式回到中央编辑器，且允许不离开文件树调整自身宽度。
      "ctrl-l": "workspace::FocusCenterPane",
      "ctrl-alt-h": ["workspace::IncreaseActiveDockSize", { "px": 0 }],
      "ctrl-alt-l": ["workspace::DecreaseActiveDockSize", { "px": 0 }],
      "%": null,
      "shift-r": null,
      "x": null,
      "s": null,
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "d": ["project_panel::Trash", { "skip_prompt": false }],
      "shift-d": ["project_panel::Delete", { "skip_prompt": false }],
      "r": "project_panel::Rename",
      "ctrl-shift-c": "project_panel::CopyPath",
      "alt-shift-c": "workspace::CopyRelativePath",
      "ctrl-k ctrl-shift-c": null,
      "alt-shift-r": "project_panel::RevealInFileManager",
      "alt-shift-s": "project_panel::OpenWithSystem"
    }
  },
  // ==========================================================
  //            窗口关闭与新建保护
  // ==========================================================
  // 取消绑定关闭 zed 窗口防止误操作
  {
    "unbind": {
      "ctrl-shift-w": "workspace::CloseWindow",
      "ctrl-shift-n": "workspace::NewWindow"
    }
  }
]
