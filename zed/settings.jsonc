// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // ==========================================================
  //            启动与基础行为
  // ==========================================================
  "cli_default_open_behavior": "new_window",
  // ==========================================================
  //            Git 面板
  // ==========================================================
  "git_panel": {
    "dock": "left",
    "group_by": "staging",
    "tree_view": true,
  },
  // ==========================================================
  //            基础键位与缩进
  // ==========================================================
  "base_keymap": "VSCode",
  "cursor_blink": true,
  // 光标平滑移动动画（Zed 1.20.1+ 新增）
  "cursor_animation": {
    "enabled": false,
  },
  // ==========================================================
  //            图标与颜色主题
  // ==========================================================
  "icon_theme": "Material Icon Theme",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "SynthWave 84 Dark",
  },
  // 自定义主题样式：显著增强搜索高亮对比度，使当前选中的匹配项一目了然
  "theme_overrides": {
    "SynthWave 84 Dark": {
      "search.match_background": "#38bdf840", // 普通搜索匹配项（半透明天蓝色）
      "search.active_match_background": "#f59e0bcc", // 当前确认/选中匹配项（高对比亮琥珀橙）
    },
    "One Light": {
      "search.match_background": "#38bdf838", // 普通搜索匹配项（半透明天蓝色）
      "search.active_match_background": "#ea580cd0", // 当前确认/选中匹配项（高对比深橙色）
    },
  },
  // ==========================================================
  //            文件树与大纲
  // ==========================================================
  // 文件树面板
  "project_panel": {
    "dock": "left",
    "git_status": true, // git 状态
    "auto_fold_dirs": false, // 防止里面单独文件的时候时候这些为一个
  },
  // 大纲面板
  "outline_panel": {
    "git_status": true,
  },
  // ==========================================================
  //            Markdown 预览
  // ==========================================================
  "markdown_preview": {
    "font_family": "JetBrains Mono",
    "limit_content_width": true,
    "max_width": 1000, // 限制内容最大宽度并居中（默认约 800px，设为 1000px 兼顾宽屏显示与阅读体验）
  },
  // ==========================================================
  //            粘贴与保存
  // ==========================================================
  "auto_indent_on_paste": true,
  "ensure_final_newline_on_save": true,
  // ==========================================================
  //            行号、滚动与标签栏
  // ==========================================================
  "minimap": {
    "show": "never",
  },
  "scrollbar": {
    "axes": {
      "horizontal": false,
      "vertical": false,
    },
  },
  "relative_line_numbers": "enabled",
  "tab_bar": {
    "show": true,
  },
  "tabs": {
    "git_status": true,
  },
  "sticky_scroll": {
    "enabled": false,
  },

  // ==========================================================
  //            Vim 模式与系统剪贴板
  // ==========================================================
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true,
    "default_mode": "normal",
    // 保持 Ctrl+C 与 Vim 的 y/d 等操作共用 Windows 系统剪贴板
    "use_system_clipboard": "always",
  },

  // ==========================================================
  //            编辑器字体与换行
  // ==========================================================
  "buffer_font_size": 18.0,
  "buffer_font_weight": 450.0,
  "buffer_line_height": {
    "custom": 1.8,
  },
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_features": {
    "calt": false,
    "liga": false,
    "dlig": false,
  },
  "buffer_font_fallbacks": ["JetBrainsMono Nerd Font"],
  "soft_wrap": "editor_width", // 编辑器与 diff 中的长行按当前可视宽度换行，避免横向滚动。

  // ==========================================================
  //            界面字体
  // ==========================================================
  "ui_font_size": 16.0,
  "ui_font_weight": 400.0,
  "ui_font_family": "JetBrains Mono",
  "ui_font_features": {
    "calt": false,
    "liga": false,
    "dlig": false,
  },
  "ui_font_fallbacks": ["JetBrainsMono Nerd Font Mono"],

  // ==========================================================
  //            集成终端
  // ==========================================================
  "terminal": {
    "font_weight": 350.0,
    "font_size": 15.0,
    "font_family": "JetBrainsMono Nerd Font",
    // 保持终端字体默认特性，不继承编辑区的连字禁用设置。
    "font_features": {},
    "font_fallbacks": ["JetBrains Mono", "JetBrainsMono Nerd Font"],
    "line_height": {
      "custom": 1.5,
    },
    "shell": "system",
  },
  "agent_ui_font_size": 15.0,
  // ==========================================================
  //            代码编辑预测
  // ==========================================================
  "edit_predictions": {
    "copilot": {},
    "provider": "zed",
  },
  // ==========================================================
  //            内联提示 (Inlay Hints)
  // ==========================================================
  "inlay_hints": {
    "enabled": false,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    // 平时隐藏，长按修饰键时才显示：
    // - Windows / Linux: Ctrl + Alt
    // - macOS: Cmd + Option (platform 映射为 Command，alt 映射为 Option)
    "toggle_on_modifiers_press": {
      "platform": true,
      "alt": true,
    },
  },
  // ==========================================================
  //            自动安装扩展
  // ==========================================================
  "auto_install_extensions": {
    "shader-ls": true,
    "glsl": true,
    "hlsl": true,
    "wgsl": true,
  },
  // ==========================================================
  //            文件类型关联
  // ==========================================================
  "file_types": {
    "HLSL": ["hlsl", "hlsli", "fx", "fxh", "ush", "usf"],
    "GLSL": [
      "glsl",
      "vert",
      "frag",
      "comp",
      "geom",
      "tesc",
      "tese",
      "mesh",
      "task",
      "rgen",
      "rint",
      "rahit",
      "rchit",
      "rmiss",
      "rcall",
    ],
    "WGSL": ["wgsl"],
  },
  // ==========================================================
  //            语言专属配置 (LSP 绑定与行为)
  // ==========================================================
  "languages": {
    "GLSL": {
      "language_servers": [
        "shader-language-server",
        "!glsl_validator",
        "!glsl_analyzer",
        "...",
      ],
    },
    "HLSL": {
      "language_servers": ["shader-language-server", "..."],
    },
    "WGSL": {
      "language_servers": ["shader-language-server", "..."],
    },
  },
  // ==========================================================
  //            LSP 语言服务器具体设置
  // ==========================================================
  "lsp": {
    "shader-language-server": {
      // 提示：Windows / Linux x86_64 扩展会自动从 GitHub 下载预编译服务；
      // macOS (Apple Silicon / Intel) 官方暂未提供预编译包，Mac 上可使用 cargo 编译并在本机配置中指定 binary.path：
      // 在下方 binary 对象中添加 "path": "/opt/homebrew/bin/shader-language-server"。
      // 启动即关闭 Vulkan / SPIR-V 校验，兼容尚未转发 --config 的 shader-ls 版本。
      "binary": {
        "arguments": [
          "--stdio",
          "--glsl",
          "--hlsl",
          "--wgsl",
          "--config",
          "{\"glsl\":{\"targetClient\":\"None\",\"spirvVersion\":\"None\"}}",
        ],
      },
      "settings": {
        // 服务端 workspace/configuration 请求使用此节名。
        "shader-validator": {
          // 通用校验与符号配置
          "validate": true,
          "symbols": true,
          "symbolDiagnostics": false,
          "severity": "info", // "none" | "error" | "warning" | "info" | "hint"
          "includes": [], // 额外包含路径，如 ["./include"]
          "defines": {}, // 预处理器全局宏，如 {"DEBUG": "1"}

          // HLSL (DirectX Shader Compiler)
          "hlsl": {
            "shaderModel": "ShaderModel6_8",
            "version": "V2021",
          },

          // GLSL：按源文件版本校验，支持 gl_FragColor 与 GL_ES，不强制 Vulkan SPIR-V。
          "glsl": {
            "targetClient": "None",
            "spirvVersion": "None",
          },

          // WGSL (naga)
          "wgsl": {},
        },
      },
    },
  },
}
