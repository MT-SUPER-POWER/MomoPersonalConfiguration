// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ COMMON CONFIG ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  "cli_default_open_behavior": "existing_window",
  "git_panel": {
    "group_by": "staging",
    "tree_view": true,
  },
  "base_keymap": "VSCode",
  "tab_size": 2,
  "cursor_blink": true,
  "icon_theme": "Material Icon Theme",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "SynthWave 84 Dark",
  },
  // 文件树面板
  "project_panel": {
    "dock": "left",
    "git_status": true, // git 状态
    "auto_fold_dirs": false, // 防止里面单独文件的时候时候这些为一个
  },
  // 大纲面板
  "outline_panel": {
    "git_status": true,
  },
  "markdown_preview_font_family": "JetBrains Mono",
  "auto_indent_on_paste": true,
  "ensure_final_newline_on_save": true,
  "minimap": {
    "show": "never",
  },
  "scrollbar": {
    "axes": {
      "horizontal": false,
      "vertical": false,
    },
  },
  "relative_line_numbers": "enabled",
  "tab_bar": {
    "show": true,
  },
  "tabs": {
    "git_status": true,
  },
  "sticky_scroll": {
    "enabled": false,
  },
  // =========== VIM CONFIG =============
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true,
    "default_mode": "normal",
    // 保持 Ctrl+C 与 Vim 的 y/d 等操作共用 Windows 系统剪贴板
    "use_system_clipboard": "always",
  },
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ EDITOR CONFIG ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  "buffer_font_size": 18.0,
  "buffer_font_weight": 450.0,
  "buffer_line_height": {
    "custom": 1.7999999523162842,
  },
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_fallbacks": [
    "JetBrainsMono Nerd Font"
  ],
  "soft_wrap": "editor_width", // 编辑器与 diff 中的长行按当前可视宽度换行，避免横向滚动。
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ UI CONFIG ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  "ui_font_size": 16.0,
  "ui_font_weight": 400.0,
  "ui_font_family": "JetBrains Mono",
  "ui_font_fallbacks": [
    "JetBrainsMono Nerd Font Mono"
  ],
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ TERMINAL CONFIG ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  "terminal": {
    "font_weight": 350.0,
    "font_size": 15.0,
    "font_family": "JetBrainsMono Nerd Font",
    "font_fallbacks": [
      "JetBrains Mono",
      "JetBrainsMono Nerd Font"
    ],
    "line_height": {
      "custom": 1.5,
    },
    "shell": "system",
  },
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ AGENT CONFIG ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  "agent": {
    "sandbox_permissions": {
      "allow_unsandboxed": true,
      "write_paths": [
        {
          "requested": "D:\\Github\\Scopify",
          "resolved": "D:\\Github\\Scopify",
          "on_windows_fs": true,
        },
      ],
    },
    "sidebar_side": "left",
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.3-codex-spark",
      "enable_thinking": true,
      "effort": "high",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "agent_ui_font_size": 15.0,
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "effort": "max",
        "model": "glm-5.3[1M]",
      },
      "type": "registry",
    },
    "codex-acp": {
      "default_config_options": {
        "fast-mode": true,
        "reasoning_effort": "max",
        "model": "gpt-5.3-codex-spark",
      },
      "type": "registry",
    },
  },
  "edit_predictions": {
    "copilot": {},
    "provider": "zed",
  },
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ LSP CONFIG ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  "languages": {
    "Vue.js": {
      "language_servers": [
        "vtsls",
        "vue-language-server",
        "..."
      ],
    },
    "Lua": {
      "language_servers": [
        "lua-language-server",
        "..."
      ],
    },
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "vtsls": {
          "tsserver": {
            "globalPlugins": [
              {
                "name": "@vue/typescript-plugin",
                "location": "C:/Users/shuhe/AppData/Local/Zed/extensions/work/vue",
                "languages": [
                  "vue.js"
                ],
                "enableForWorkspaceTypeScriptVersions": true,
                "configNamespace": "typescript",
              },
            ],
          },
        },
      },
    },
  },
}
